{
  "name": "settlement-engine-mcp-server",
  "version": "0.1.0",
  "description": "MCP server over the settlement engine's Lab sandbox. Read-only by default.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "settlement-engine-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsx scripts/sync-forbidden-hosts.ts && tsc -p tsconfig.build.json && tsx scripts/copy-docs.ts",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "start": "node dist/index.js",
    "evals": "tsx evals/run.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
